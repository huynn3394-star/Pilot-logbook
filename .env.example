# Disabled until the user-owned Firebase project, Google provider, exact owned origin and private rules are configured.
ATPL_ACCOUNTS_ENABLED=false
ATPL_APP_ORIGIN=https://avilog.up.railway.app
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_APP_ID=
# Whole-app sync and private evidence remain disabled until their release checks pass.
AVILOG_WORKSPACE_SYNC_ENABLED=false
AVILOG_EVIDENCE_SYNC_ENABLED=false
FIREBASE_STORAGE_BUCKET=
# Local emulator only (requires localhost origin and demo-* project):
ATPL_USE_EMULATORS=false

# Server-only MET Office credentials. HTTPS with a valid certificate is required;
# HTTP fallback and cross-origin redirects are blocked. On TLS failure use NOAA.
# Leave blank to use NOAA only. Never put these in public config or browser assets.
MET_OFFICE_USERNAME=
MET_OFFICE_PASSWORD=

# V14 metadata: enable ONLY after deploying the V14 Firestore rules and updating all clients.
AVILOG_LOGBOOK_V14_ENABLED=false

# Owner-only statistics. Stay disabled until a private persistent volume and owner are set.
AVILOG_ADMIN_ENABLED=false
AVILOG_ADMIN_EMAILS=
# Local development only; on Railway, use its mounted volume's avilog-admin subdirectory.
AVILOG_ADMIN_DATA_DIR=
