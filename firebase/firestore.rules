rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner(uid) {return request.auth != null && request.auth.uid == uid && request.auth.token.firebase.sign_in_provider == 'google.com';}
  function bank(code) {return code in ['POF','COM','INS','MET','RNAV','LAW','MB','MBR','AGK','PERF','OPS','HUM'];}
  function identity(d,code) {return bank(code) && d.schemaVersion == 1 && d.code == code && d.bankSHA256 is string && d.bankSHA256.matches('^[a-f0-9]{64}$') && d.epoch is string && d.epoch.matches('^[A-Za-z0-9:_-]{1,128}$');}
  function smallState(s) {return s is map && s.keys().hasOnly(['version','progress','wrong','bookmarks','examHistory','study','exam','settings','updatedAt']) && s.version == 2 && s.progress is map && s.progress.size() <= 1000 && s.wrong is list && s.wrong.size() <= 1000 && s.bookmarks is list && s.bookmarks.size() <= 1000 && s.settings is map && s.settings.keys().hasOnly(['theme','language']) && s.settings.theme in ['light','dark','system'] && s.settings.language in ['vi','en','both'] && s.examHistory == [] && s.study == null && s.exam == null;}
  match /users/{uid} {
   allow get: if owner(uid);
   match /workspaces/{workspaceId} {
    function workspace() {return workspaceId == 'main';}
    function headPath() {return /databases/$(database)/documents/users/$(uid)/workspaces/$(workspaceId);}
    function headRevision() {return getAfter(headPath()).data.revision;}
    function schema(d) {return d.schemaVersion == 1 && d.revision is int && d.revision > 0 && d.revision <= 1000000000;}
    function optionalText(d,key,n) {return !(key in d) || (d[key] is string && d[key].size() <= n);}
    function optionalBool(d,key) {return !(key in d) || d[key] is bool;}
    function evidence(d) {return d is map && d.keys().hasOnly(['sha256','mime','bytes','cloudReady']) && d.sha256.matches('^[a-f0-9]{64}$') && d.mime in ['image/jpeg','image/png','image/webp'] && d.bytes is int && d.bytes > 0 && d.bytes <= 6291456 && d.cloudReady is bool;}
    function weatherReport(d) {return d is map && d.keys().hasOnly(['station','provider','fetchedAt','source','sources','metar','taf','stale','cached']) && d.station is string && d.station.matches('^[A-Z]{4}$') && d.provider is string && d.provider.size() <= 160 && d.fetchedAt is string && d.fetchedAt.size() <= 40 && d.source is string && d.source.size() <= 512 && (d.metar == null || (d.metar is string && d.metar.size() <= 32768 && !d.metar.matches('^data:image/.*'))) && (d.taf == null || (d.taf is string && d.taf.size() <= 32768 && !d.taf.matches('^data:image/.*')));}
    function weather(d) {return d is map && d.keys().hasOnly(['day','reports']) && d.day is string && d.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && d.reports is list && d.reports.size() <= 2 && (d.reports.size() == 0 || weatherReport(d.reports[0])) && (d.reports.size() < 2 || weatherReport(d.reports[1]));}
    function optionalInt(d,k,n) {return !(k in d) || (d[k] is int && d[k] >= 0 && d[k] <= n);}
    function logbookData(d) {return d is map && d.keys().hasOnly(['version','sicMinutes','picusMinutes','ifrMinutes','vfrMinutes','instrumentMinutes','crossCountryMinutes','takeoffDay','takeoffNight','landingDay','landingNight']) && d.version == 1 && optionalInt(d,'sicMinutes',1440) && optionalInt(d,'picusMinutes',1440) && optionalInt(d,'ifrMinutes',1440) && optionalInt(d,'vfrMinutes',1440) && optionalInt(d,'instrumentMinutes',1440) && optionalInt(d,'crossCountryMinutes',1440) && optionalInt(d,'takeoffDay',20) && optionalInt(d,'takeoffNight',20) && optionalInt(d,'landingDay',20) && optionalInt(d,'landingNight',20);}
    function auditData(d) {return d is map && d.keys().hasOnly(['version','entries']) && d.version == 1 && d.entries is list && d.entries.size() <= 100;}
    // Keep every prior audit entry. This is an app history, not a certified signature.
    function auditKept(before,after) {return !('auditTrail' in before.data) || ('auditTrail' in after.data && after.data.auditTrail.entries.hasAll(before.data.auditTrail.entries));}
    function flightData(d) {return d.keys().hasOnly(['id','date','flightNo','dep','dest','aircraft','reg','scheduled','actual','confirmed','role','picMinutes','nightMinutes','takeoffBy','landingBy','landingMode','captainId','foId','crewIds','source','confidence','note','dutyId','updatedAt','weather','logbook','auditTrail']) && (!('logbook' in d) || logbookData(d.logbook)) && (!('auditTrail' in d) || auditData(d.auditTrail)) && d.date is string && d.flightNo is string && d.flightNo.size() <= 16 && d.dep is string && d.dep.size() <= 4 && d.dest is string && d.dest.size() <= 4 && (!('scheduled' in d) || d.scheduled is map) && (!('actual' in d) || d.actual is map) && optionalBool(d,'confirmed') && optionalText(d,'note',3000) && optionalText(d,'source',120) && (!('crewIds' in d) || (d.crewIds is list && d.crewIds.size() <= 100)) && (!('weather' in d) || (weather(d.weather) && d.weather.day == d.date));}
    function personData(d) {return d.keys().hasOnly(['id','name','rank','note']) && d.name is string && d.name.size() > 0 && d.name.size() <= 80 && d.rank is string && d.rank.size() <= 80 && optionalText(d,'note',1000);}
    function dutyData(d) {return d.keys().hasOnly(['id','date','type','report','release','note']) && d.date is string && d.type in ['FLIGHT','STANDBY','RESERVE','DAY OFF','POSITIONING','SIM','TRAINING'] && optionalText(d,'report',40) && optionalText(d,'release',40) && optionalText(d,'note',3000);}
    function profileData(d) {return d.keys().hasOnly(['name','base']) && d.name is string && d.name.size() > 0 && d.name.size() <= 60 && d.base is string && d.base.size() <= 4;}
    // Unique entries drawn only from the bounded (<=40) airport list are themselves bounded.
    function weatherGroup(g,a) {let n=g.name; let p=g.airports; return g.keys().hasOnly(['id','name','airports']) && g.id.matches('^[A-Za-z0-9_-]{1,64}$') && n is string && n.size() > 0 && n.size() <= 60 && p.toSet().size() == p.size() && p.hasOnly(a);}
    function weatherGroups(d) {let g=d.get('weatherGroups',[]); let a=d.get('weatherAirports',[]); let count=g is list ? g.size() : -1; return !('weatherGroups' in d) || ('weatherAirports' in d && count >= 0 && count <= 8 && (count <= 0 || weatherGroup(g[0],a)) && (count <= 1 || weatherGroup(g[1],a)) && (count <= 2 || weatherGroup(g[2],a)) && (count <= 3 || weatherGroup(g[3],a)) && (count <= 4 || weatherGroup(g[4],a)) && (count <= 5 || weatherGroup(g[5],a)) && (count <= 6 || weatherGroup(g[6],a)) && (count <= 7 || weatherGroup(g[7],a)));}
    function preferencesData(d) {return d.keys().hasOnly(['tomorrow','beforeDuty','missingActual','leadMinutes','eveningHour','weatherAirports','weatherGroups']) && weatherGroups(d) && (!('weatherAirports' in d) || (d.weatherAirports is list && d.weatherAirports.size() <= 40 && d.weatherAirports.toSet().size() == d.weatherAirports.size())) && optionalBool(d,'tomorrow') && optionalBool(d,'beforeDuty') && optionalBool(d,'missingActual') && (!('leadMinutes' in d) || (d.leadMinutes is int && d.leadMinutes >= 5 && d.leadMinutes <= 1440)) && (!('eveningHour' in d) || (d.eveningHour is int && d.eveningHour >= 0 && d.eveningHour <= 23));}
    function record(d) {return schema(d) && d.keys().hasOnly(['schemaVersion','kind','id','revision','archived','data','evidence','archive']) && d.kind in ['profile','preferences','flight','duty','person'] && d.id is string && d.id.size() > 0 && d.id.size() <= 100 && d.archived is bool && d.data is map && (!('evidence' in d) || (d.kind == 'flight' && evidence(d.evidence))) && (!d.archived || ('archive' in d && d.archive is map && d.archive.keys().hasOnly(['id','at']) && d.archive.id is string && d.archive.at is string)) && ((d.kind == 'profile' && d.id == 'profile' && !d.archived && profileData(d.data)) || (d.kind == 'preferences' && d.id == 'preferences' && !d.archived && preferencesData(d.data)) || (d.kind in ['flight','duty','person'] && d.data.id == d.id && ((d.kind == 'flight' && flightData(d.data)) || (d.kind == 'duty' && dutyData(d.data)) || (d.kind == 'person' && personData(d.data)))));}
    allow get,list: if owner(uid) && workspace();
    // Equal revisions must reach the SDK's update-time retry, as in the ATPL transport.
    allow create,update: if owner(uid) && workspace() && schema(request.resource.data) && request.resource.data.keys().hasOnly(['schemaVersion','revision','updatedAt']) && request.resource.data.updatedAt == request.time && (request.method == 'create' || (request.resource.data.revision >= resource.data.revision && request.resource.data.revision <= resource.data.revision + 1));
    match /records/{recordKey} {
     allow get,list: if owner(uid) && workspace();
     allow create,update: if owner(uid) && workspace() && recordKey.matches('^[a-f0-9]{64}$') && record(request.resource.data) && request.resource.data.revision == headRevision() && (request.method == 'create' || (request.resource.data.id == resource.data.id && request.resource.data.kind == resource.data.kind && request.resource.data.revision >= resource.data.revision && auditKept(resource.data,request.resource.data)));
    }
    match /flightKeys/{keyHash} {
     allow get,list: if owner(uid) && workspace();
     allow create,update: if owner(uid) && workspace() && keyHash.matches('^[a-f0-9]{64}$') && schema(request.resource.data) && request.resource.data.keys().hasOnly(['schemaVersion','key','flightId','recordKey','revision']) && request.resource.data.key is string && request.resource.data.key.size() <= 128 && request.resource.data.flightId is string && request.resource.data.recordKey.matches('^[a-f0-9]{64}$') && request.resource.data.revision == headRevision() && getAfter(/databases/$(database)/documents/users/$(uid)/workspaces/$(workspaceId)/records/$(request.resource.data.recordKey)).data.id == request.resource.data.flightId && !getAfter(/databases/$(database)/documents/users/$(uid)/workspaces/$(workspaceId)/records/$(request.resource.data.recordKey)).data.archived;
     allow delete: if owner(uid) && workspace() && headRevision() >= resource.data.revision;
    }
    match /receipts/{operationId} {
     allow get,list: if owner(uid) && workspace();
     allow create: if owner(uid) && workspace() && operationId.matches('^[A-Za-z0-9:_-]{1,128}$') && schema(request.resource.data) && request.resource.data.keys().hasOnly(['schemaVersion','uid','operationId','operationHash','priorRevision','revision','results']) && request.resource.data.uid == uid && request.resource.data.operationId == operationId && request.resource.data.operationHash.matches('^[a-f0-9]{64}$') && request.resource.data.priorRevision is int && request.resource.data.priorRevision >= 0 && request.resource.data.revision == request.resource.data.priorRevision + 1 && request.resource.data.revision == headRevision() && request.resource.data.results is list && request.resource.data.results.size() > 0 && request.resource.data.results.size() <= 8;
    }
    match /imports/{importId} {
     allow get,list: if owner(uid) && workspace();
     allow create: if owner(uid) && workspace() && schema(request.resource.data) && request.resource.data.keys().hasOnly(['schemaVersion','hash','index','total','operationId','revision','recordKeys']) && request.resource.data.hash.matches('^[a-f0-9]{64}$') && importId.matches('^'+request.resource.data.hash+'-[0-9]+$') && request.resource.data.index is int && request.resource.data.index >= 0 && request.resource.data.total is int && request.resource.data.total > request.resource.data.index && request.resource.data.operationId.matches('^[A-Za-z0-9:_-]{1,128}$') && request.resource.data.recordKeys is list && request.resource.data.recordKeys.size() > 0 && request.resource.data.recordKeys.size() <= 8 && request.resource.data.revision == headRevision();
    }
   }
   match /banks/{code} {
    allow get,list: if owner(uid) && bank(code);
    // Transaction update-time preconditions arbitrate concurrent writers; equal revision must reach retry.
    allow create,update: if owner(uid) && identity(request.resource.data,code) && request.resource.data.keys().hasOnly(['schemaVersion','code','bankSHA256','epoch','revision','state','selected']) && request.resource.data.revision is int && request.resource.data.revision > 0 && request.resource.data.revision <= 1000000000 && smallState(request.resource.data.state) && request.resource.data.selected is map && request.resource.data.selected.keys().hasOnly(['study','exam']) && (request.method == 'create' || (request.resource.data.bankSHA256 == resource.data.bankSHA256 && request.resource.data.revision >= resource.data.revision));
    match /sessions/{sessionId} {
     allow get,list: if owner(uid) && bank(code);
     allow create,update: if owner(uid) && identity(request.resource.data,code) && sessionId.matches('^[A-Za-z0-9:_-]{1,128}$') && request.resource.data.keys().hasOnly(['schemaVersion','code','bankSHA256','epoch','kind','revision','state']) && request.resource.data.kind in ['study','exam'] && request.resource.data.revision is int && request.resource.data.revision > 0 && (request.resource.data.state == null || (request.resource.data.state is map && request.resource.data.state.ids is list && request.resource.data.state.ids.size() <= 1000 && request.resource.data.state.answers is map && request.resource.data.state.answers.size() <= 1000)) && (request.method == 'create' || (request.resource.data.epoch == resource.data.epoch && request.resource.data.kind == resource.data.kind && request.resource.data.revision >= resource.data.revision));
    }
    match /exams/{reportId} {
     allow get,list: if owner(uid) && bank(code);
     allow create: if owner(uid) && identity(request.resource.data,code) && request.resource.data.keys().hasOnly(['schemaVersion','code','bankSHA256','epoch','hash','report']) && request.resource.data.hash.matches('^[a-f0-9]{64}$') && reportId == request.resource.data.epoch + '~' + request.resource.data.hash && request.resource.data.report is map && request.resource.data.report.keys().hasOnly(['at','size','correct','percent','results']) && request.resource.data.report.size is int && request.resource.data.report.size >= 0 && request.resource.data.report.size <= 1000 && request.resource.data.report.correct is int && request.resource.data.report.correct >= 0 && request.resource.data.report.correct <= request.resource.data.report.size && (!('results' in request.resource.data.report) || (request.resource.data.report.results is list && request.resource.data.report.results.size() == request.resource.data.report.size));
    }
    match /receipts/{batchId} {
     allow get,list: if owner(uid) && bank(code);
     allow create: if owner(uid) && identity(request.resource.data,code) && request.resource.data.keys().hasOnly(['schemaVersion','code','bankSHA256','epoch','batchId','revision','deviceId','importIds']) && batchId == request.resource.data.batchId && batchId.matches('^[A-Za-z0-9:_-]{1,128}$') && request.resource.data.deviceId is string && request.resource.data.deviceId.size() <= 128 && request.resource.data.revision is int && request.resource.data.revision > 0 && request.resource.data.importIds is list && request.resource.data.importIds.size() <= 10;
    }
    match /imports/{importId} {
     allow get,list: if owner(uid) && bank(code);
     allow create: if owner(uid) && identity(request.resource.data,code) && request.resource.data.keys().hasOnly(['schemaVersion','code','bankSHA256','epoch','hash']) && request.resource.data.hash.matches('^[a-f0-9]{64}$') && importId == request.resource.data.epoch + '~' + request.resource.data.hash;
    }
   }
  }
  match /{document=**} {allow read,write: if false;}
 }
}
